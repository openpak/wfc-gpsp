[Unit]
Description=OpenPak WFC gpsp
After=openpak-postgres.service

[Container]
ContainerName=openpak-wfc-gpsp
Image=ghcr.io/openpak/wfc-gpsp:latest
Network=openpak.network
EnvironmentFile=%h/openpak/deploy/wfc-full/wfc-gpsp.env
Volume=%h/openpak/deploy/wfc-split/token.key:/keys/wfc-token.key:ro,U
PublishPort=0.0.0.0:29901:29901/tcp

[Service]
Restart=always

[Install]
WantedBy=default.target
